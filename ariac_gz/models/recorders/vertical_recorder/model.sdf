<?xml version="1.0"?>
<sdf version="1.11">
  <model name="vertical_recorder">
    <static>true</static>

    <link name="link">
      <sensor type="camera" name="rgb_camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        
        <camera>
          <horizontal_fov>1.57</horizontal_fov>
          <image>
            <width>840</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>