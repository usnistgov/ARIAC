<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="vg_2">
    <allow_auto_disable>true</allow_auto_disable>
    <link name="base_link">
      <inertial auto="true"/>
      
      <visual name="visual">
        <pose>0 0 -0.06 3.14 0 -1.57</pose>
        <geometry>
          <mesh>
            <uri>model://vacuum_tools/meshes/vg_2_visual.gltf</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <density>2700</density>
        <geometry>
          <mesh>
            <uri>model://vacuum_tools/meshes/vg_2_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
        
    </link>

    <link name="antistick_link1">
      <inertial auto="true"/>
      <pose> 0.025 0 -0.06305 0 0 0 </pose>
      <collision name="collision">
        <density>1</density>
        <geometry>
          <box>
            <size>0.01 0.01 0.001</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="antistick_link2">
      <inertial auto="true"/>
      <pose> -0.025 0 -0.06305 0 0 0 </pose>
      <collision name="collision">
        <density>1</density>
        <geometry>
          <box>
            <size>0.01 0.01 0.001</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="antistick_joint1" type="fixed">
      <parent>base_link</parent>
      <child>antistick_link1</child>
    </joint>

    <joint name="antistick_joint2" type="fixed">
      <parent>base_link</parent>
      <child>antistick_link2</child>
    </joint>

    <link name="contact_link">
      <inertial auto="true"/>
      <pose> 0 0 -0.00505 0 0 0</pose>
      <collision name="collision">
        <density>1</density>
        <geometry>
          <cylinder>
            <radius>0.007</radius>
            <length>0.0001</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="contact_joint" type="prismatic">
      <parent>base_link</parent>
      <child>contact_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.002</lower>
          <upper>0.0</upper>
          <effort>10</effort>
        </limit>
      </axis>
    </joint>

    <!-- Gripper sensors -->
    <link name="suction_1_link">
      <inertial auto="true"/>
      <pose> 0.025 0 -0.066 0 0 0 </pose>
      <collision name="collision">
        <density>1</density>
        <geometry>
          <cylinder>
            <radius>0.0085</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name='contact_sensor' type='contact'>
        <update_rate>30</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
        <plugin
          filename="libContactPlugin.so"
          name="ariac_plugins::ContactPlugin">
          <search_term>vg_2</search_term>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>
    </link>

    <link name="suction_2_link">
      <inertial auto="true"/>
      <pose> -0.025 0 -0.066 0 0 0 </pose>
      <collision name="collision">
        <density>1</density>
        <geometry>
          <cylinder>       
            <radius>0.0085</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name='contact_sensor' type='contact'>
        <update_rate>30</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
        <plugin
          filename="libContactPlugin.so"
          name="ariac_plugins::ContactPlugin">
          <search_term>vg_2</search_term>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>
    </link>

    <joint name="suction_1_joint" type="prismatic">
      <parent>base_link</parent>
      <child>suction_1_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.004</upper>
          <effort>10</effort>
        </limit>
      </axis>
    </joint>

    <joint name="suction_2_joint" type="prismatic">
      <parent>base_link</parent>
      <child>suction_2_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.004</upper>
          <effort>10</effort>
        </limit>
      </axis>
    </joint>

    <plugin
      filename="libVacuumToolPlugin.so"
      name="ariac_plugins::VacuumToolPlugin">
      <ros>
        <namespace>/vacuum_tool/vg_2</namespace>
      </ros>
      <tool_type>1</tool_type>
    </plugin>
  </model>
</sdf>