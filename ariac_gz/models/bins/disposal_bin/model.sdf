<?xml version="1.0" ?>
<sdf version="1.11">
  <model name="disposal_bin">
    <static>true</static>
    <link name="bin_link">
      <collision name='collision'>
        <pose> 0 0 0.05 0 0 0 </pose>
        <geometry>
          <box>
            <size> 0.15 0.25 0.01 </size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://bins/meshes/blue_bin.dae</uri>
            <scale> 0.25 0.35 0.25 </scale>
          </mesh>
        </geometry>
       </visual>

       <sensor name='collision_detector' type='contact'>
        <update_rate>30</update_rate>
          <contact>
            <collision>collision</collision>
          </contact>
      </sensor>

    </link>

    <plugin
      filename="libEntityDisposalPlugin.so"
      name="ariac_plugins::EntityDisposalPlugin">
      <contact_link>bin_link</contact_link>
    </plugin>

  </model>
</sdf>