<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="inspection_robot_1">
  <xacro:include filename="$(find ariac_description)/urdf/robot_macro.xacro"/>

  <xacro:robot 
    name="inspection_robot_1"
    model="ur3e"
    x="1.6"
    y="0.6"
    z="0.4"
    yaw="${pi/2}"
    controllers="$(find ariac_description)/config/inspection_robot_1_controllers.yaml"
    initial_positions="$(find ariac_description)/config/inspection_robot_1_positions.yaml">
  </xacro:robot>
  
</robot>