<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="battery_cell">
    <link name="base_link">
      <inertial auto="true"/>
      
      <visual name="visual">
        <pose> 0 0 0 0 0 0 </pose>
        <geometry>
          <mesh>
            <uri>model://battery_cell/meshes/li-ion/base.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <density>5000</density>
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0105</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
      </collision>
        
    </link>
  </model>
</sdf>