{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["COMPETITOR_NAME", "SENSORS", "CONVEYOR_SPEED", "CELL_FEED_RATE"],
  "properties": {
    "COMPETITOR_NAME": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "SENSORS": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["NAME", "TYPE", "POSE", "UPDATE_RATE"],
        "properties": {
          "NAME": { "type": "string" },
          "TYPE": {
            "type": "string",
            "enum": ["break_beam", "distance", "lidar", "camera"]
          },
          "POSE": {
            "type": "object",
            "required": ["XYZ", "RPY"],
            "properties": {
              "XYZ": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "RPY": {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "number" }
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "additionalProperties": false
          },
          "UPDATE_RATE": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          },
          "HORIZONTAL": {
            "type": "object",
            "required": ["SAMPLES", "MIN_ANGLE", "MAX_ANGLE"],
            "properties": {
              "SAMPLES": { "type": "integer", "minimum": 1 },
              "MIN_ANGLE": {
                "anyOf": [{ "type": "number" }, { "type": "string" }]
              },
              "MAX_ANGLE": {
                "anyOf": [{ "type": "number" }, { "type": "string" }]
              }
            },
            "additionalProperties": false
          },
          "VERTICAL": {
            "type": "object",
            "required": ["SAMPLES", "MIN_ANGLE", "MAX_ANGLE"],
            "properties": {
              "SAMPLES": { "type": "integer", "minimum": 1 },
              "MIN_ANGLE": {
                "anyOf": [{ "type": "number" }, { "type": "string" }]
              },
              "MAX_ANGLE": {
                "anyOf": [{ "type": "number" }, { "type": "string" }]
              }
            },
            "additionalProperties": false
          },
          "RESOLUTION": {
            "type": "string",
            "enum": ["720p", "1080p"]
          },
          "FOV": {
            "type": "number",
            "minimum": 0,
            "maximum": 3.14159
          }
        },
        "additionalProperties": false
      }
    },
    "CONVEYOR_SPEED": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.1
    },
    "CELL_FEED_RATE": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "additionalProperties": false
}
