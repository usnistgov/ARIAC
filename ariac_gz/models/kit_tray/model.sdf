<?xml version="1.0" ?>
<sdf version="1.11">
  <model name="kit_tray">

    <link name="base_link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://kit_tray/meshes/kit_tray_visual.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://kit_tray/meshes/kit_tray_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <link name="center_slot_link">
      <pose relative_to="base_link">0.0 0.0 0.0095 0.0 0.0 0.0</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.001</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name='contact_sensor' type='contact'>
        <update_rate>30</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
        <plugin
          filename="libContactPlugin.so"
          name="ariac_plugins::ContactPlugin">
          <search_term>cell</search_term>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>
    </link>

    <joint name="center_slot_joint" type="fixed">
      <parent>base_link</parent>
      <child>center_slot_link</child>
    </joint>

    <link name="slot_1_link">
      <pose relative_to="base_link">-0.065 0.05 0.032 0 0 0</pose>
      <collision name="left">
        <pose>-0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://kit_tray/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='left_contact_sensor' type='contact'>
        <update_rate>30</update_rate>
        <contact>
          <collision>left</collision>
        </contact>
        <plugin
          filename="libContactPlugin.so"
          name="ariac_plugins::ContactPlugin">
          <search_term>cell</search_term>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>

      <collision name="right">
        <pose>0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://kit_tray/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='right_contact_sensor' type='contact'>
        <update_rate>30</update_rate>
        <contact>
          <collision>right</collision>
        </contact>
        <plugin
          filename="libContactPlugin.so"
          name="ariac_plugins::ContactPlugin">
          <search_term>cell</search_term>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>
    </link>

