<?xml version="1.0" ?>
<sdf version="1.11">
  <model name="agv">

    <link name="base_link">

      <gravity>False</gravity>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://agv/meshes/agv.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <density>2700</density>
        <pose>0 0 0.175 0 0 0</pose>
        <geometry>
          <box>
            <size> 0.5 0.25 0.35 </size>
          </box>
        </geometry>
      </collision>

      <sensor name='collision_detector' type='contact'>
        <update_rate>30</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>

    </link>

    <plugin
      filename="libAgvMotionPlugin.so"
      name="ariac_plugins::AgvMotionPlugin">
    </plugin>

    <plugin
      filename="libAgvTrayInterfacePlugin.so"
      name="ariac_plugins::AgvTrayInterfacePlugin">
    </plugin>

  
  </model>

</sdf>

