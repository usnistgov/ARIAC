<?xml version="1.0" ?>
<sdf version="1.11">
  <model name="agv">

    <link name="agv">

      <gravity>False</gravity>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://agv/meshes/agv.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <density>2700</density>
        <pose>0 0 0.175 0 0 0</pose>
        <geometry>
          <box>
            <size> 0.5 0.25 0.35 </size>
          </box>
        </geometry>
      </collision>

      <sensor name='collision_detector' type='contact'>
        <update_rate>30</update_rate>
          <contact>
            <collision>collision</collision>
          </contact>
      </sensor>

    </link>

    <link name="tray_link">

      <gravity>False</gravity>

      <pose relative_to="agv">0 0 0.35 0 0 -1.57</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_visual.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">

        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_collision.stl</uri>
          </mesh>
        </geometry>

      </collision>

    </link>

    <link name="center_slot_link">
      <pose relative_to="tray_link">0.0 0.0 0.0095 0.0 0.0 0.0</pose>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.001</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name='contact_sensor' type='contact'>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>
    </link>

    <joint name="center_slot_joint" type="fixed">
      <parent>tray_link</parent>
      <child>center_slot_link</child>
    </joint>

    <link name="slot_1_link">
      <gravity>False</gravity>
      <pose relative_to="tray_link">-0.065 0.05 0.032 0 0 0</pose>
      <collision name="left">
        <pose>-0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='left_contact_sensor' type='contact'>
        <contact>
          <collision>left</collision>
        </contact>
      </sensor>

      <collision name="right">
        <pose>0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='right_contact_sensor' type='contact'>
        <update_rate>30</update_rate>
        <contact>
          <collision>right</collision>
        </contact>
      </sensor>
    </link>

    <link name="slot_2_link">
      <gravity>False</gravity>
      <pose relative_to="tray_link">0.065 0.05 0.032 0 0 0</pose>

      <collision name="left">
        <pose>-0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='left_contact_sensor' type='contact'>
        <update_rate>30</update_rate>
        <contact>
          <collision>left</collision>
        </contact>
      </sensor>

      <collision name="right">
        <pose>0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='right_contact_sensor' type='contact'>
        <update_rate>30</update_rate>
        <contact>
          <collision>right</collision>
        </contact>
      </sensor>
    </link>

    <link name="slot_3_link">
      <gravity>False</gravity>
      <pose relative_to="tray_link">-0.065 -0.05 0.032 0 0 0</pose>

      <collision name="left">
        <pose>-0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='left_contact_sensor' type='contact'>
        <contact>
          <collision>left</collision>
        </contact>
      </sensor>

      <collision name="right">
        <pose>0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='right_contact_sensor' type='contact'>
        <contact>
          <collision>right</collision>
        </contact>
      </sensor>
    </link>

    <link name="slot_4_link">
      <gravity>False</gravity>
      <pose relative_to="tray_link">0.065 -0.05 0.032 0 0 0</pose>

      <collision name="left">
        <pose>-0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='left_contact_sensor' type='contact'>
        <contact>
          <collision>left</collision>
        </contact>
      </sensor>

      <collision name="right">
        <pose>0.035 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://agv/meshes/kit_tray_slot_collision.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <sensor name='right_contact_sensor' type='contact'>
        <contact>
          <collision>right</collision>
        </contact>
      </sensor>
    </link>

    <joint name="tray_joint" type="fixed">
      <parent>agv</parent>
      <child>tray_link</child>
    </joint>

    <joint name="slot_1_joint" type="fixed">
      <parent>tray_link</parent>
      <child>slot_1_link</child>
    </joint>

    <joint name="slot_2_joint" type="fixed">
      <parent>tray_link</parent>
      <child>slot_2_link</child>
    </joint>

    <joint name="slot_3_joint" type="fixed">
      <parent>tray_link</parent>
      <child>slot_3_link</child>
    </joint>

    <joint name="slot_4_joint" type="fixed">
      <parent>tray_link</parent>
      <child>slot_4_link</child>
    </joint>

    <plugin
      filename="libAgvMotionPlugin.so"
      name="ariac_plugins::AgvMotionPlugin">
    </plugin>

    <plugin
      filename="libAgvTrayPlugin.so"
      name="ariac_plugins::AgvTrayPlugin">
    </plugin>


    <plugin
      filename="libEntityDisposalPlugin.so"
      name="ariac_plugins::EntityDisposalPlugin">
      <contact_link>agv</contact_link>
    </plugin>

    <plugin
      filename="libTFPublisherPlugin.so"
      name="ariac_plugins::TFPublisherPlugin">
      <base_link>agv</base_link>
      <static>false</static>
      <child link="tray_link" frame="tray_frame"/>
      <child link="slot_1_link" frame="slot1_frame" parent_frame="tray_frame" parent_link="tray_link"/>
      <child link="slot_2_link" frame="slot2_frame" parent_frame="tray_frame" parent_link="tray_link"/>
      <child link="slot_3_link" frame="slot3_frame" parent_frame="tray_frame" parent_link="tray_link"/>
      <child link="slot_4_link" frame="slot4_frame" parent_frame="tray_frame" parent_link="tray_link"/>
    </plugin>
  
  </model>

</sdf>

