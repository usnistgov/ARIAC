<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="walls">
  <static>true</static>

    <link name="base_link">

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://walls/meshes/walls.glb</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <density>2700</density>
        <geometry>
          <mesh>
            <uri>model://walls/meshes/walls.glb</uri>
          </mesh>
        </geometry>
      </collision>

      <inertial auto="true"/>

    </link> 

  </model>

</sdf>