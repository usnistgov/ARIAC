<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="break_beam">
    <static>true</static>

    <link name="break_beam_link">
      <visual name="visual">
        <pose>-0.0225 0 -0.0075 0 0 0</pose>
        
        <geometry>
          <mesh>
            <scale>1.5 1.5 1.5</scale>
            <uri>model://sensors/break_beam/meshes/break_beam.glb</uri>
          </mesh>
        </geometry>

      </visual>

      <sensor type="gpu_lidar" name="break_beam_0">
        <topic>break_beam_0_gz_topic</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.001</min>
            <max>0.3</max>
            <resolution>0.001</resolution>
          </range>
        </lidar>

        <update_rate>5</update_rate>

        <plugin name="ariac_plugins::RaySensorPlugin" filename="libRaySensorPlugin.so">
          <sensor_name>break_beam_0</sensor_name>
          <sensor_type>break_beam</sensor_type>
        </plugin>
      </sensor>
    </link>

    <plugin
      filename="libTFPublisherPlugin.so"
      name="ariac_plugins::TFPublisherPlugin">
      <base_link>break_beam_link</base_link>
      <static>true</static>
      <sensor>true</sensor>
    </plugin>
  </model>
</sdf>